<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_small_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Left side: Calories, Progress Bar, Macros -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <!-- Header: Calories title and percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_small_kcal_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1 850 / 2 500 ккал"
                android:textColor="@color/notif_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/notif_small_kcal_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="74%"
                android:textColor="@color/notif_color_kcal"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Calories Progress Bar -->
        <ProgressBar
            android:id="@+id/notif_small_progress_kcal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="4dp"
            android:max="100"
            android:progress="74"
            android:progressDrawable="@drawable/progress_bar_calories" />

        <!-- Macros -->
        <TextView
            android:id="@+id/notif_small_macros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🥩 120г • 🍞 210г • 🥑 65г"
            android:textColor="@color/notif_text_secondary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right side: Full-Height Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Quick Add Food Button -->
        <FrameLayout
            android:id="@+id/btn_notif_small_add"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notif_button_accent"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notif_add" />
        </FrameLayout>

        <!-- Quick Barcode Scan Button -->
        <FrameLayout
            android:id="@+id/btn_notif_small_scan"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notif_button_accent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notif_barcode" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
