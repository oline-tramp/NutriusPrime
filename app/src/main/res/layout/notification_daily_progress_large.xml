<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_large_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Header: Calories title and remaining/percent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_large_kcal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 850 / 2 500 ккал"
            android:textColor="@color/notif_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_large_kcal_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="74% • ост. 650 ккал"
            android:textColor="@color/notif_color_kcal"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Calories Progress Bar -->
    <ProgressBar
        android:id="@+id/notif_large_progress_kcal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="74"
        android:progressDrawable="@drawable/progress_bar_calories" />

    <!-- 1. Protein Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/notif_label_protein"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥩 Белки"
            android:textColor="@color/notif_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/notif_val_protein"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="120 / 150 г (80%)"
            android:textColor="@color/notif_color_protein"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notif_progress_protein"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="3dp"
        android:max="100"
        android:progress="80"
        android:progressDrawable="@drawable/progress_bar_protein" />

    <!-- 2. Fat Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/notif_label_fat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥑 Жиры"
            android:textColor="@color/notif_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/notif_val_fat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="65 / 80 г (81%)"
            android:textColor="@color/notif_color_fat"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notif_progress_fat"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="3dp"
        android:max="100"
        android:progress="81"
        android:progressDrawable="@drawable/progress_bar_fat" />

    <!-- 3. Carbs Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/notif_label_carbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍞 Углеводы"
            android:textColor="@color/notif_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/notif_val_carbs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="210 / 280 г (75%)"
            android:textColor="@color/notif_color_carbs"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notif_progress_carbs"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="3dp"
        android:max="100"
        android:progress="75"
        android:progressDrawable="@drawable/progress_bar_carbs" />

    <!-- 4. Fiber and Water Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/notif_val_fiber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🥗 Клетчатка: 24 / 35 г"
            android:textColor="@color/notif_color_fiber"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notif_val_water"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧 Вода: 2.1 / 3.0 л"
            android:textColor="@color/notif_color_water"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Add Food Button -->
        <LinearLayout
            android:id="@+id/btn_notif_large_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button_accent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_notif_add" />

            <TextView
                android:id="@+id/btn_notif_large_add_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добавить еду"
                android:textColor="@color/notif_color_kcal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <!-- Barcode Scan Button -->
        <LinearLayout
            android:id="@+id/btn_notif_large_scan"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_button_accent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_notif_barcode" />

            <TextView
                android:id="@+id/btn_notif_large_scan_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Штрихкод"
                android:textColor="@color/notif_color_kcal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
